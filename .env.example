# Local secrets, never committed. `.env.local` is read by `next dev`; `.dev.vars` is read by `pnpm preview` (wrangler, workerd). Copy this file to both and keep them in sync. Production values are set in the Cloudflare dashboard.

# Data driver (spec 011)
DATA_DRIVER=                        # demo | supabase. Empty = supabase when the Supabase vars below are set, otherwise demo (typed mock data in memory: no Docker, no keys, resets on restart)
DEMO_SESSION_SECRET=                # demo driver, public deploy: long random value that signs the demo admin cookie; empty = a fixed dev secret + a warning
DEMO_UPLOAD_MAX_MB=                 # demo driver: max size in MB of one uploaded photo kept in memory (all its sizes together); the total cap is 20x that; empty = 2 per photo, 40 total

# Supabase (only for DATA_DRIVER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only (sync, admin actions)

# Plektan CRM
PLEKTAN_API_KEY=                    # x-auth-token; empty = fixture mode
PLEKTAN_LANG=uk
PLEKTAN_LEADS_FIXTURE=               # local only: ok | fail = fake Plektan leads transport; empty + empty key = Plektan channel skipped

# Cloudflare R2 (photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=     # empty = the forms render no widget
TURNSTILE_SECRET_KEY=               # server only; empty = fixture mode (the check always passes)

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_FIXTURE=                   # local only: ok | fail = fake Telegram transport (logs without personal data); empty + empty keys = Telegram channel skipped

# AI assistant (spec 010)
LLM_API_KEY=                        # OpenAI key, server only; empty = the scripted fixture assistant (answers locally, costs nothing)
LLM_MODEL=                          # empty = gpt-4o-mini
LLM_MONTHLY_BUDGET_USD=             # monthly spend cap in USD, counted from token usage; empty = 20. Over it the chat shows the fallback
ASSISTANT_RATE_LIMIT=               # visitor messages per IP in the window; empty = 20
ASSISTANT_RATE_WINDOW_MIN=          # rate-limit window in minutes; empty = 10
ASSISTANT_CONVERSATION_LIMIT=       # visitor messages per conversation; empty = 30 (a message is at most 1000 characters)
ASSISTANT_IP_SALT=                  # secret salt for hashing visitor IPs (the raw IP is never stored); empty = a fixed dev salt + a warning. Set a long random value in production

# Sync cron protection
CRON_SECRET=                        # bearer for /api/cron/*; also sent by the sync script (pnpm sync) when it purges the site cache

# Site
NEXT_PUBLIC_SITE_URL=               # production domain, e.g. https://7sky.example (canonical URLs, metadataBase); empty = http://localhost:3000 in dev; a production build on the demo driver warns and uses it, on the supabase driver it fails
SEO_ALLOW_LOCALHOST=               # local only: 1 lets a production build on the supabase driver (pnpm build / preview) run without NEXT_PUBLIC_SITE_URL; otherwise that build fails (the demo driver never needs it)

# Plektan sync (spec 003)
PLEKTAN_FIXTURE_SET=                # fixture mode only (empty key): base (default) | next
PLEKTAN_COUNTRY_ID=                 # scope of the sync (search needs a geography); fill once the key exists
PLEKTAN_REGION_ID=                  # same
PLEKTAN_LOCALITY_ID=                # same
GEOCODER_CONTACT_EMAIL=             # Nominatim usage policy: an email for the User-Agent (max 1 request/s); empty = fixture mode
