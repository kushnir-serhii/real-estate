# Copy to .env.local (Next.js) and .dev.vars (wrangler preview). Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only (sync, admin actions)

# Plektan CRM
PLEKTAN_API_KEY=                    # x-auth-token; empty = fixture mode
PLEKTAN_LANG=uk

# Cloudflare R2 (photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# AI assistant (spec 010)
LLM_API_KEY=

# Sync cron protection
CRON_SECRET=
